{
  "name": "见词 / WordSnap — Signal Tech",
  "version": "1.0",
  "colors": {
    "ink-black": { "hex": "#0b0b0f", "role": "主文字、icon、底部导航选中态" },
    "canvas-white": { "hex": "#f9f9fb", "role": "页面底色" },
    "pure-white": { "hex": "#ffffff", "role": "卡片、弹窗、按钮文字" },
    "signal-blue": { "hex": "#2f5cff", "role": "主品牌色、CTA按钮、激活态" },
    "violet-haze": { "hex": "#7068f0", "role": "辅助强调、复习待处理标记" },
    "mint": { "hex": "#00c896", "role": "已掌握标记、正向反馈" },
    "amber-flash": { "hex": "#ffa940", "role": "拍照/捕捉功能色" },
    "cool-gray": { "hex": "#f0f0f5", "role": "Badge底色、未激活tab" },
    "light-border": { "hex": "#e2e2ea", "role": "卡片边框、分割线" }
  },
  "typography": {
    "word-display": {
      "family": "Source Serif 4",
      "weight": "600",
      "purpose": "单词卡片展示、详情页标题词"
    },
    "heading": {
      "family": "Inter",
      "weight": "600",
      "tracking": "-0.02em",
      "purpose": "页面标题、模块标题"
    },
    "body": {
      "family": "Inter",
      "weight": "400",
      "purpose": "释义、按钮、导航、所有功能文字"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weight": "400",
      "purpose": "复习统计、单词计数、进度数字"
    }
  },
  "type-scale": {
    "caption": { "size": 12, "line-height": 1.4 },
    "body-sm": { "size": 14, "line-height": 1.5 },
    "body": { "size": 16, "line-height": 1.6 },
    "subheading": { "size": 20, "line-height": 1.4 },
    "heading-sm": { "size": 24, "line-height": 1.2 },
    "heading": { "size": 32, "line-height": 1.1 },
    "display": { "size": 40, "line-height": 1.1 },
    "word-card": { "size": 28, "line-height": 1.2 }
  },
  "radius": {
    "button": 100,
    "card": 20,
    "input": 12,
    "badge": 12
  },
  "spacing": {
    "unit": 4,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "2xl": 48,
    "section": 64
  },
  "icons": {
    "style": "line",
    "stroke": 1.5,
    "fill": "少量填充仅用于选中态"
  },
  "elevation": {
    "method": "1px border + 微弱色差，不用 box-shadow"
  }
}
